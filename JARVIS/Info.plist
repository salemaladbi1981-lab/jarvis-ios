<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleDisplayName</key>
    <string>JARVIS</string>
    <key>CFBundleName</key>
    <string>JARVIS</string>
    <key>CFBundleIdentifier</key>
    <string>com.salemai.jarvis</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIRequiresFullScreen</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
    </dict>
    <key>UIAppFonts</key>
    <array>
        <string>IBMPlexSansArabic-Regular.ttf</string>
        <string>IBMPlexSansArabic-Bold.ttf</string>
        <string>CormorantGaramond-SemiBold.ttf</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>NSCalendarsUsageDescription</key>
    <string>يحتاج جارفس الوصول إلى التقويم لعرض مواعيدك اليوم عند طلبك.</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>يحتاج جارفس وصولاً كاملاً للتقويم لقراءة اجتماعاتك ومواعيدك عند طلبك فقط.</string>
    <key>NSRemindersUsageDescription</key>
    <string>يحتاج جارفس الوصول إلى التذكيرات لعرض مهامك عند طلبك.</string>
    <key>NSRemindersFullAccessUsageDescription</key>
    <string>يحتاج جارفس وصولاً كاملاً للتذكيرات لعرض مهامك وتحديثها بعد موافقتك.</string>
    <key>NSAlarmKitUsageDescription</key>
    <string>يستخدم جارفس المنبه لتذكيرك في الوقت الذي تطلبه.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>يحتاج جارفس الميكروفون للمحادثة الصوتية معك.</string>
    <key>NSCameraUsageDescription</key>
    <string>يحتاج جارفس الكاميرا لالتقاط الصور والفيديو عند طلبك.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>يحتاج جارفس الوصول إلى مكتبة الصور لاختيار المرفقات.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>يحتاج جارفس حفظ المخرجات في مكتبة الصور.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>يحتاج جارفس موقعك الحالي لعرض مدينتك وحساب المسافة ووقت الوصول عند طلبك.</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.salemai.jarvis</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>jarvis</string>
            </array>
        </dict>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
