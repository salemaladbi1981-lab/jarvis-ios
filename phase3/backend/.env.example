# Copy to .env — never commit real values.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
ELEVENLABS_API_KEY=
JARVIS_REALTIME_PROVIDER=openai
JARVIS_REALTIME_MODEL=gpt-4o-realtime-preview
# TTS: "elevenlabs" (صوت خليجي واقعي، النص من OpenAI) أو "openai" (صوت النموذج نفسه).
# يرجع تلقائياً لـ openai إذا كان elevenlabs مطلوباً بلا ELEVENLABS_API_KEY.
JARVIS_TTS_PROVIDER=elevenlabs
JARVIS_ELEVENLABS_MODEL=eleven_flash_v2_5
# مفتاح الصوت الافتراضي من سجل voices.py (يختاره د. سالم من الإعدادات).
JARVIS_ELEVENLABS_VOICE=omar_deep
# اختياري: استبدال سجل الأصوات بالكامل بأصوات خليجية أصلية (JSON).
# JARVIS_ELEVENLABS_VOICES={"khaleeji_1":{"id":"<voice_id>","name":"Khaleeji","name_ar":"خليجي"}}
JARVIS_AUDIT_PATH=audit.jsonl
JARVIS_REGISTRY_PATH=AGENT-REGISTRY.json
